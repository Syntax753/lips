{
  "name": "lips-coordinator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Claude Agent SDK coordinator + REPL that delegates boolean comparisons to short-lived per-comparator subagents backed by the Go MCP server.",
  "bin": {
    "lips": "./dist/repl.js",
    "lips-mcp": "./dist/mcpServer.js",
    "lips-mcp-smart": "./dist/mcpServerSmart.js"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.json",
    "setup": "tsx src/bootstrap.ts",
    "dev": "tsx src/repl.ts",
    "repl": "node dist/repl.js",
    "mcp": "node dist/mcpServer.js",
    "mcp:dev": "tsx src/mcpServer.ts",
    "mcp:smart": "node dist/mcpServerSmart.js",
    "mcp:smart:dev": "tsx src/mcpServerSmart.ts",
    "bench": "tsx src/corpus/bench.mts",
    "connect": "tsx src/cli/connect.mts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.150",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
